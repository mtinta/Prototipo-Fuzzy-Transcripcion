<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: la grabación del docente (voces del aula, con menores) no va a la nube ni a otro equipo -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="evaluacion/audio" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="evaluacion/audio" />
    </device-transfer>
</data-extraction-rules>
